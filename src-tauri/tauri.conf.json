{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aiMonitor",
  "version": "0.3.3",
  "identifier": "urWesley.aiMonitor",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "aiMonitor",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false
      },
      {
        "label": "usage",
        "title": "AI Usage",
        "width": 340,
        "height": 540,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "transparent": true,
        "shadow": true
      },
      {
        "label": "settings",
        "title": "aiMonitor Settings",
        "width": 480,
        "height": 600,
        "visible": false,
        "center": true,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UsageTray.ViewModels"
        x:Class="UsageTray.Views.UsageWindow"
        x:DataType="vm:UsageViewModel"
        Title="AI Usage"
        Width="340"
        Height="460"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Background="#1E1E1E"
        TransparencyLevelHint="AcrylicBlur">
  <Border CornerRadius="10" Padding="16" BorderBrush="#3A3A3A" BorderThickness="1">
    <Grid RowDefinitions="Auto,*,Auto">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="AI Usage" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding LastUpdated}" Opacity="0.7" Margin="8,0" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Content="↻" Command="{Binding RefreshCommand}" IsEnabled="{Binding !IsRefreshing}" Width="32"/>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="0,12,0,12">
        <ItemsControl ItemsSource="{Binding Providers}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProviderCardViewModel">
              <Border Margin="0,0,0,10" Padding="12" CornerRadius="8" Background="#2A2A2A">
                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Error}" Foreground="#F87171" IsVisible="{Binding HasError}"/>
                  <ItemsControl ItemsSource="{Binding Bars}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:UsageBarViewModel">
                        <StackPanel Margin="0,0,0,6" Spacing="4">
                          <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding Label}"/>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayText}"/>
                          </Grid>
                          <ProgressBar Minimum="0" Maximum="{Binding Maximum}" Value="{Binding Value}" Height="8"/>
                          <TextBlock Text="{Binding ResetText}" Opacity="0.6" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Settings" Name="SettingsButton"/>
        <Button Content="Quit" Name="QuitButton"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
